generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // pooled (Supabase via Vercel integration)
  directUrl = env("POSTGRES_URL_NON_POOLING") // used by migrations
}

model Room {
  id             String    @id @default(cuid())
  code           String    @unique
  hostId         String?
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  progress       Json // see RoomProgress in src/lib/types.ts
  scene          Json? // physical-room games (The Nightingale Express): see TrainScene in src/server/train
  gameId         String    @default("ada-voss") // which escape room; more games later
  finishedAt     DateTime? // when the final puzzle was solved (escape time = finishedAt - createdAt)
  status         String    @default("playing") // "playing" | "voting" | "finished"
  ending         String? // "EXPOSE" | "PROTECT"
  voteDeadline   DateTime?
  players        Player[]
  notes          Note[]
  attempts       Attempt[]
  hints          HintRequest[]
  votes          EndingVote[]
  chat           ChatMessage[]
  events         AnalyticsEvent[]
}

model Player {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  token       String   @unique
  userId      String? // set when the player is signed in with Google
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  image       String? // Google profile photo, if signed in
  displayName String
  color       String
  currentView String? // e.g. "browser:thedrift.blog" or "app:notes"
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
}

/// A Google-signed-in person. Anonymous players have no User.
model User {
  id        String       @id @default(cuid())
  /// Legacy Google subject id (deprecated; AuthIdentity is the identity key). Still written for Google sign-ins
  /// during the rollout; dropped in a later migration.
  googleSub String?      @unique
  email     String?
  /// True when `email` came from a sign-in provider that verified it. Only verified emails count for admin.
  emailVerified Boolean  @default(false)
  name      String?
  image     String?
  createdAt DateTime     @default(now())
  identities AuthIdentity[]
  passkeys  Passkey[]
  players   Player[]
  cases     CaseRecord[]
  purchases GamePurchase[]
  codesMade PurchaseCode[] @relation("CodeCreatedBy")
  redemptions CodeRedemption[]
}

/// One sign-in account (Google today; Apple etc. later) linked to a User. A User can have several.
model AuthIdentity {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // next-auth provider id: "google", "apple", ...
  providerAccountId String // the provider's stable subject id
  email             String?
  emailVerified     Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// A WebAuthn passkey that signs its User in. Public key only; the private key never leaves the device.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url credential id from the authenticator
  publicKey    Bytes
  counter      Int       @default(0) // signature counter, to spot cloned authenticators
  transports   String[]
  deviceType   String // "singleDevice" | "multiDevice" (synced, e.g. iCloud Keychain)
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// A one-time sign-in code emailed to `email` (lowercased). Only its hash is stored.
model EmailCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  ipHash     String? // hashed requester IP, for rate limiting
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

/// A pending WebAuthn challenge (single use, short-lived). `userId` is set for registration, not for sign-in.
model AuthChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  kind      String // "register" | "login"
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Permanent right for a user to host a game. Created by redeeming a code (later: Stripe).
model GamePurchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  source    String // "code" | "stripe"
  sourceRef String? // PurchaseCode.id, or a Stripe checkout session id later
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
}

/// Code an admin generates for one game. Redeeming it creates a GamePurchase.
/// Single-use codes have maxUses 1; group codes allow more (null = unlimited), once per account.
model PurchaseCode {
  id          String           @id @default(cuid())
  code        String           @unique // stored normalized: uppercase, no dashes
  gameId      String
  note        String?
  maxUses     Int?             @default(1) // null = unlimited
  useCount    Int              @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime? // turned off by an admin; purchases already made stay
  createdById String
  createdBy   User             @relation("CodeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  redemptions CodeRedemption[]

  @@index([gameId, createdAt])
}

/// One account claiming one code. An account can claim a given code only once.
model CodeRedemption {
  id        String       @id @default(cuid())
  codeId    String
  code      PurchaseCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([codeId, userId])
}

/// Permanent record of a finished case for a signed-in player. Survives room expiry.
model CaseRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      String
  roomRef     String // Room.id at the time; the room itself may be gone
  roomCode    String
  startedAt   DateTime
  finishedAt  DateTime
  durationMs  Int
  ending      String? // filled in once the vote resolves
  wasHost     Boolean
  playerCount Int
  /// Badges the team earned in this case: "compass", "envelope" (Ada), "everyclue" (the train)
  badges      String[] @default([])
  createdAt   DateTime @default(now())

  @@unique([userId, roomRef])
  @@index([userId, gameId])
}

model Note {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId    String
  visibility  String // "PRIVATE" | "PUBLIC"
  body        String
  fragmentTag String? // "name" | "year" | "id" | "cipher" | "address"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([roomId, visibility])
}

model Attempt {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerId  String
  puzzleId  String
  input     String
  correct   Boolean
  createdAt DateTime @default(now())

  @@index([roomId, puzzleId, createdAt])
}

model HintRequest {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  puzzleId  String
  tier      Int
  playerId  String?
  createdAt DateTime @default(now())

  @@unique([roomId, puzzleId, tier])
}

model EndingVote {
  roomId   String
  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerId String
  choice   String // "EXPOSE" | "PROTECT"

  @@id([roomId, playerId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  roomRef   String // room id, kept after the room expires so stats survive
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  playerId  String?
  type      String // "site.visit" | "attempt" | "hint" | "puzzle.solved" | "room.created" | "ending"
  data      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

/// Room chat. Deleted with the room (48h inactivity or replaced by the host).
model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerId  String
  body      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

/// One finished room on a game's public leaderboard. Written when the final puzzle is solved and kept
/// after the room expires. No room code is stored publicly here beyond roomRef (an internal id).
model LeaderboardEntry {
  id            String   @id @default(cuid())
  gameId        String
  roomRef       String   @unique // Room.id at the time
  players       Json // [{ name, color }] in join order
  playerCount   Int
  startedAt     DateTime
  finishedAt    DateTime
  durationMs    Int
  attempts      Int // every answer submitted, right or wrong
  wrongAttempts Int
  hintsUsed     Int
  ending        String? // filled in once the vote resolves
  /** False when the team finished but got it wrong (e.g. accused the wrong suspect): ranked below every solve. */
  solved        Boolean  @default(true)
  /** An admin's test run: kept, but off every public board and rank. */
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([gameId, durationMs])
}
