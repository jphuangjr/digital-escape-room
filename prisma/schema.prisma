generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // pooled (Supabase via Vercel integration)
  directUrl = env("POSTGRES_URL_NON_POOLING") // used by migrations
}

model Room {
  id             String    @id @default(cuid())
  code           String    @unique
  hostId         String?
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  progress       Json // see RoomProgress in src/lib/types.ts
  gameId         String    @default("ada-voss") // which escape room; more games later
  finishedAt     DateTime? // when the final puzzle was solved (escape time = finishedAt - createdAt)
  status         String    @default("playing") // "playing" | "voting" | "finished"
  ending         String? // "EXPOSE" | "PROTECT"
  voteDeadline   DateTime?
  players        Player[]
  notes          Note[]
  attempts       Attempt[]
  hints          HintRequest[]
  votes          EndingVote[]
  events         AnalyticsEvent[]
}

model Player {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  token       String   @unique
  userId      String? // set when the player is signed in with Google
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  image       String? // Google profile photo, if signed in
  displayName String
  color       String
  currentView String? // e.g. "browser:thedrift.blog" or "app:notes"
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
}

/// A Google-signed-in person. Anonymous players have no User.
model User {
  id        String       @id @default(cuid())
  googleSub String       @unique
  email     String?
  name      String?
  image     String?
  createdAt DateTime     @default(now())
  players   Player[]
  cases     CaseRecord[]
  purchases GamePurchase[]
  codesMade PurchaseCode[] @relation("CodeCreatedBy")
  codesUsed PurchaseCode[] @relation("CodeRedeemedBy")
}

/// Permanent right for a user to host a game. Created by redeeming a code (later: Stripe).
model GamePurchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  source    String // "code" | "stripe"
  sourceRef String? // PurchaseCode.id, or a Stripe checkout session id later
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
}

/// Single-use code an admin generates for one game. Redeeming it creates a GamePurchase.
model PurchaseCode {
  id           String    @id @default(cuid())
  code         String    @unique // stored normalized: uppercase, no dashes
  gameId       String
  note         String?
  createdById  String
  createdBy    User      @relation("CodeCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  redeemedById String?
  redeemedBy   User?     @relation("CodeRedeemedBy", fields: [redeemedById], references: [id])
  redeemedAt   DateTime?

  @@index([gameId, createdAt])
}

/// Permanent record of a finished case for a signed-in player. Survives room expiry.
model CaseRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      String
  roomRef     String // Room.id at the time; the room itself may be gone
  roomCode    String
  startedAt   DateTime
  finishedAt  DateTime
  durationMs  Int
  ending      String? // filled in once the vote resolves
  wasHost     Boolean
  playerCount Int
  createdAt   DateTime @default(now())

  @@unique([userId, roomRef])
  @@index([userId, gameId])
}

model Note {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId    String
  visibility  String // "PRIVATE" | "PUBLIC"
  body        String
  fragmentTag String? // "name" | "year" | "id" | "cipher" | "address"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([roomId, visibility])
}

model Attempt {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerId  String
  puzzleId  String
  input     String
  correct   Boolean
  createdAt DateTime @default(now())

  @@index([roomId, puzzleId, createdAt])
}

model HintRequest {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  puzzleId  String
  tier      Int
  playerId  String?
  createdAt DateTime @default(now())

  @@unique([roomId, puzzleId, tier])
}

model EndingVote {
  roomId   String
  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerId String
  choice   String // "EXPOSE" | "PROTECT"

  @@id([roomId, playerId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  roomRef   String // room id, kept after the room expires so stats survive
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  playerId  String?
  type      String // "site.visit" | "attempt" | "hint" | "puzzle.solved" | "room.created" | "ending"
  data      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
