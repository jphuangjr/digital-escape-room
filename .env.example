POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/escape"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/escape"
# Protects GET /api/admin/analytics?token=...
ADMIN_TOKEN=""
# Optional: Supabase Realtime. Without these the client falls back to polling.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Sign-in (optional). Each provider is enabled when all of its variables below are set; with none set, the app
# runs fully anonymous. Every provider's OAuth redirect URI is <origin>/api/auth/callback/<provider id>.
# Google (provider id "google"):
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Sign in with Apple (provider "apple"); all four from developer.apple.com. AUTH_APPLE_ID is the Services ID
# (e.g. "com.escapeescape.web") with return URL https://<domain>/api/auth/callback/apple; the private key is the
# .p8 file's contents (newlines or "\n" escapes). The client secret JWT is minted from it at startup. Apple only
# accepts registered domains, so it won't work on preview URLs or localhost.
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""
# Email-code sign-in (provider "email") through Resend: an API key and a sender on a domain verified in Resend.
# Without them email sign-in is off in production; locally (next dev) codes are printed to the server log instead.
RESEND_API_KEY=""
EMAIL_FROM="Escape Escape <login@escape-escape.com>"
# Passkeys (provider "passkey") turn on with any provider above. Their relying party is the request's host;
# set AUTH_RP_ID only to pin it (e.g. "www.escape-escape.com").
AUTH_RP_ID=""
# Random string used to sign session cookies (needed for any provider): openssl rand -base64 32
AUTH_SECRET=""
# Local dev only; on Vercel the origin is detected from the request.
NEXTAUTH_URL="http://localhost:3000"

# Admin emails (comma-separated): can host every game and generate purchase codes at /admin. An email only counts
# when the sign-in provider verified it.
ACCOUNT_ADMIN=""
