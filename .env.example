POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/escape"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/escape"
# Protects GET /api/admin/analytics?token=...
ADMIN_TOKEN=""
# Optional: Supabase Realtime. Without these the client falls back to polling.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google sign-in (optional; without these the app runs fully anonymous).
# OAuth client redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Random string used to sign session cookies: openssl rand -base64 32
AUTH_SECRET=""
# Local dev only; on Vercel the origin is detected from the request.
NEXTAUTH_URL="http://localhost:3000"

# Admin emails (comma-separated): can host every game and generate purchase codes at /admin.
ACCOUNT_ADMIN=""
